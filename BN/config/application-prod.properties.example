# 운영(Production) 전용 설정 템플릿 — 실제 파일은 Git에 커밋하지 않음
#
# ★ 이 example 파일은 Spring Boot가 읽지 않습니다.
#   서버에서 실제로 읽는 파일: /opt/ondo/config/application-prod.properties
#
#   sudo cp BN/config/application-prod.properties.example /opt/ondo/config/application-prod.properties
#   sudo nano /opt/ondo/config/application-prod.properties
#   sudo chmod 600 /opt/ondo/config/application-prod.properties
#
# 점검:  sudo bash BN/scripts/ec2-preflight.sh   (FAIL 이 있으면 배포가 중단됩니다)
# 배포:  sudo ./BN/scripts/deploy-ec2.sh

spring.profiles.active=prod

# ----------------------------------------------------------------
# MySQL (EC2 로컬 MariaDB 또는 RDS)
# ----------------------------------------------------------------
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/ondo_DB?createDatabaseIfNotExist=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
spring.datasource.username=root
spring.datasource.password=your-db-password
spring.jpa.hibernate.ddl-auto=update
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

# ----------------------------------------------------------------
# Redis (EC2 로컬 또는 ElastiCache)
# ----------------------------------------------------------------
# Spring Boot 3 이름 — 예전 spring.redis.* 는 무시됩니다
spring.data.redis.host=127.0.0.1
spring.data.redis.port=6379

# ----------------------------------------------------------------
# JWT (32자 이상)
# ----------------------------------------------------------------
ondo.jwt.secret=change-me-prod-jwt-secret-at-least-32-bytes!!

# ----------------------------------------------------------------
# 암호화 (사전상담 전화번호) — 운영은 반드시 dev-mode=false + 실제 키
#   키 만들기: openssl rand -base64 32   (44자, 서버 밖 안전한 곳에도 보관 — 잃어버리면 복호화 불가)
#   dev-mode=true 이고 key 가 비어 있으면 코드에 공개된 개발용 키로 암호화됩니다.
# ----------------------------------------------------------------
ondo.encryption.dev-mode=false
ondo.encryption.key=
# 예전에 개발용 키로 저장된 데이터가 있으면 1회 true 로 기동 → 로그에서 '실패 0건' 확인 → false
ondo.encryption.migrate-from-dev-key=false

# ----------------------------------------------------------------
# APP
# ----------------------------------------------------------------
ondo.app.base-url=https://ondo.ai.kr

# ----------------------------------------------------------------
# MAIL — dev-mode=true 여도 spring.mail.host 는 필수 (JavaMailSender 빈 생성용)
# 실제 발송은 ondo.mail.dev-mode=false + SMTP 설정 시에만
# ----------------------------------------------------------------
ondo.mail.dev-mode=true
spring.mail.host=localhost
spring.mail.port=25
spring.mail.username=ondo@ondo.local
spring.mail.password=
spring.mail.properties.mail.smtp.auth=false

# ----------------------------------------------------------------
# 외부 API / SMS
# ----------------------------------------------------------------
ondo.solapi.dev-mode=true
ondo.neis.dev-mode=false
ondo.neis.api-key=your-neis-api-key
ondo.weather.dev-mode=false
ondo.weather.api-key=your-weather-api-key

# ----------------------------------------------------------------
# Admin (최초 1회 생성 후 enabled=false, password 줄도 비우기)
# ----------------------------------------------------------------
ondo.admin.bootstrap.enabled=false
ondo.admin.bootstrap.username=admin
ondo.admin.bootstrap.password=
ondo.admin.bootstrap.name=시스템관리자

# ----------------------------------------------------------------
# 운영자 오류 알림 — 처리되지 않은 서버 오류, 개인정보 자동 파기 실패를 메일로 알림
# (ondo.mail.dev-mode=false 이고 SMTP 가 설정돼 있어야 실제로 발송됩니다)
# ----------------------------------------------------------------
ondo.alert.enabled=true
ondo.alert.email=운영자_메일_주소
ondo.alert.cooldown-minutes=30
ondo.alert.daily-limit=30
