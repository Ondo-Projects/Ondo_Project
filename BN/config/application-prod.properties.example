# 운영(Production) 전용 설정 (Git에 커밋하지 않음)
#
# ★ 중요: 이 example 파일은 Spring Boot가 읽지 않습니다.
#   반드시 복사해서 application-prod.properties 를 만드세요:
#
#   cd BN/config
#   cp application-prod.properties.example application-prod.properties
#   nano application-prod.properties
#
# EC2 기동:
#   cd BN
#   bash scripts/ec2-preflight.sh
#   export SPRING_PROFILES_ACTIVE=prod
#   ./gradlew bootRun --no-daemon

spring.profiles.active=prod

# ----------------------------------------------------------------
# MySQL (EC2 로컬 MariaDB 또는 RDS)
# ----------------------------------------------------------------
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/ondo_DB?createDatabaseIfNotExist=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
spring.datasource.username=root
spring.datasource.password=your-db-password
spring.jpa.hibernate.ddl-auto=update
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

# ----------------------------------------------------------------
# Redis (EC2 로컬 또는 ElastiCache)
# ----------------------------------------------------------------
spring.redis.host=127.0.0.1
spring.redis.port=6379

# ----------------------------------------------------------------
# JWT (32자 이상)
# ----------------------------------------------------------------
ondo.jwt.secret=change-me-prod-jwt-secret-at-least-32-bytes!!

# ----------------------------------------------------------------
# 암호화 — 첫 기동은 dev-mode true 권장
# ----------------------------------------------------------------
ondo.encryption.dev-mode=true
ondo.encryption.key=

# ----------------------------------------------------------------
# APP
# ----------------------------------------------------------------
ondo.app.base-url=http://YOUR_EC2_PUBLIC_IP

# ----------------------------------------------------------------
# 외부 API / 메일 / SMS (dev-mode true 면 SMTP·SMS 없이도 기동 가능)
# ----------------------------------------------------------------
ondo.mail.dev-mode=true
ondo.solapi.dev-mode=true
ondo.neis.dev-mode=false
ondo.neis.api-key=your-neis-api-key
ondo.weather.dev-mode=false
ondo.weather.api-key=your-weather-api-key

# ----------------------------------------------------------------
# Admin (최초 1회 생성 후 enabled=false)
# ----------------------------------------------------------------
ondo.admin.bootstrap.enabled=true
ondo.admin.bootstrap.username=admin
ondo.admin.bootstrap.password=ChangeMe1!
ondo.admin.bootstrap.name=시스템관리자
