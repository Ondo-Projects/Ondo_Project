# 로컬 개발 전용 설정 (Git에 커밋하지 않음)
#
# 사용 방법:
#   cd BN\config
#   copy application-local.properties.example application-local.properties
#   (값을 본인 환경에 맞게 수정)
#
# BN 폴더에서 bootRun: .\gradlew.bat bootRun

# ----------------------------------------------------------------
# MySQL (로컬) — 운영 DB 와 절대 같은 DB 를 쓰지 마세요
#   DB 는 처음 실행할 때 자동으로 만들어집니다 (createDatabaseIfNotExist)
# ----------------------------------------------------------------
spring.datasource.url=jdbc:mysql://localhost:3306/ondo_local?createDatabaseIfNotExist=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
spring.datasource.username=root
spring.datasource.password=여기에_로컬_MySQL_비밀번호
spring.jpa.hibernate.ddl-auto=update
# 로컬·테스트용: 테스트가 많으면 기본값(10개)으로는 MySQL 접속 수를 넘어 "Too many connections" 가 납니다
spring.datasource.hikari.maximum-pool-size=3
spring.datasource.hikari.minimum-idle=1

# ----------------------------------------------------------------
# Redis (로컬) — WSL Ubuntu: sudo service redis-server start
# ----------------------------------------------------------------
spring.data.redis.host=localhost
spring.data.redis.port=6379

# ----------------------------------------------------------------
# JWT (32바이트 이상 — 로컬 전용, 운영과 다른 값 사용)
# ----------------------------------------------------------------
ondo.jwt.secret=local-dev-jwt-secret-key-at-least-32-bytes!!
# Chrome·Edge·Firefox 는 http://localhost 에서도 Secure 쿠키를 허용합니다. Safari 로 개발할 때만 false
# ondo.jwt.cookie-secure=false

# ----------------------------------------------------------------
# APP / SERVER (로컬)
# ----------------------------------------------------------------
ondo.app.base-url=http://localhost:8081

# ----------------------------------------------------------------
# MAIL (Mailpit 등 로컬 SMTP)
# ----------------------------------------------------------------
ondo.mail.dev-mode=true
spring.mail.host=localhost
spring.mail.port=1025
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false

# ----------------------------------------------------------------
# Solapi SMS — 로컬은 dev-mode true 가능 (실 발송 없이 테스트)
# ----------------------------------------------------------------
ondo.solapi.dev-mode=true
ondo.solapi.api-key=
ondo.solapi.api-secret=
ondo.solapi.sender-phone=

# ----------------------------------------------------------------
# FIELD ENCRYPTION — 로컬 dev-mode (키 없이 동작)
# ----------------------------------------------------------------
ondo.encryption.dev-mode=true
ondo.encryption.key=

# ----------------------------------------------------------------
# NEIS (나이스) Open API
# ----------------------------------------------------------------
# API 키가 없으면 dev-mode=true (가짜 데이터로 동작)
ondo.neis.dev-mode=true
ondo.neis.api-key=

# ----------------------------------------------------------------
# 기상청 단기예보 (data.go.kr)
# ----------------------------------------------------------------
ondo.weather.dev-mode=true
ondo.weather.api-key=

# ----------------------------------------------------------------
# Admin 최초 계정 (username 없을 때 1회 생성 — 이후 enabled=false 권장)
# ----------------------------------------------------------------
# 로컬 관리자 계정이 필요할 때만 true + username/password 입력
ondo.admin.bootstrap.enabled=false
ondo.admin.bootstrap.username=
ondo.admin.bootstrap.password=
ondo.admin.bootstrap.name=
